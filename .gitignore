*.npz
*.csv
data/
datasets/

# Exception: allow results/metrics CSVs
!phase2_resolution_ablation/*.csv
!phase1_*/*.csv

# Jupyter / Kaggle notebook checkpoints
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
*.swp